# Supabase Postgres URL strategy
# 1) Runtime on Vercel/serverless: use transaction pooler URL (port 6543)
# 2) Local/dev fallback: DATABASE_URL can point to direct DB URL
# 3) Prisma migrations: DIRECT_URL should point to non-transaction endpoint

# Runtime URL (preferred in production):
# DATABASE_POOLER_URL="postgresql://<USER>:<PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Runtime fallback URL:
# DATABASE_URL="postgresql://<USER>:<PASSWORD>@<DB_HOST>:5432/postgres?sslmode=require"

# Migrations URL:
# DIRECT_URL="postgresql://<USER>:<PASSWORD>@<DIRECT_HOST>:5432/postgres?sslmode=require"


# Local API URL for client-side requests
NEXT_PUBLIC_API_URL=http://localhost:4000
