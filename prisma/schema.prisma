generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

enum CurriculumType {
  CBSE
  ICSE
  STATE_BOARD
  INTERNATIONAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Student-specific fields (nullable for non-students)
  grade                Int?
  curriculum           CurriculumType?
  location             String?
  parentEmail          String?
  subscriptionPlan     SubscriptionPlan @default(FREE)

  courses                    Course[]       @relation("InstructorCourses")
  enrollments                Enrollment[]
  submissions                Submission[]
  assignments                Assignment[]   @relation("CreatedBy")
  searchQueries              SearchQuery[]
  conversationHistories      ConversationHistory[]
  parentReports              ParentReport[]
  childSubjects              ChildSubject[]
  generatedAssignments       GeneratedAssignment[]
  practiceTests              PracticeTest[]
  practiceAttempts           PracticeAttempt[]
  // Teacher-role relations (student side)
  classEnrollments           ClassEnrollment[]              @relation("StudentEnrollments")
  teacherSubmissions         TeacherAssignmentSubmission[]  @relation("StudentSubmissions")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  code        String   @unique
  instructor  User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments  Enrollment[]
  assignments  Assignment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Assignment {
  id          String             @id @default(uuid())
  title       String
  description String?
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  creator     User               @relation("CreatedBy", fields: [createdBy], references: [id])
  createdBy   String
  dueDate     DateTime?
  status      AssignmentStatus   @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  submissions Submission[]
}

model Submission {
  id           String   @id @default(uuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  contents     String
  grade        Float?
  feedback     String?
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

// Search and Research Features
model SearchQuery {
  id                  String   @id @default(uuid())
  student             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId           String
  query               String
  subject             String?
  conversationId      String?
  attachmentIds       String[] @default([]) // Array of SearchAttachment IDs
  voiceInput          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  responses           SearchResponse[]
  attachments         SearchAttachment[]
  conversationHistory ConversationHistory[]
}

model SearchResponse {
  id              String   @id @default(uuid())
  searchQuery     SearchQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  queryId         String
  response        String   // Rich formatted content
  resourceLinks   String[] @default([]) // Array of resource URLs
  sourceLinks     String[] @default([]) // Internal/external source links
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SearchAttachment {
  id            String   @id @default(uuid())
  searchQuery   SearchQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  queryId       String
  fileName      String
  fileType      String   // pdf, doc, image, audio, excel
  fileUrl       String   // S3 or storage URL
  fileSize      Int      // In bytes
  uploadedAt    DateTime @default(now())
}

model ConversationHistory {
  id              String   @id @default(uuid())
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  initialQuery    SearchQuery @relation(fields: [initialQueryId], references: [id], onDelete: Cascade)
  initialQueryId  String
  followUpQueries String[] @default([]) // JSON array of follow-up questions
  conversationLog String   // JSON stringified conversation thread
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ParentReport {
  id              String   @id @default(uuid())
  parent          User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId        String
  reportDate      DateTime @default(now())
  weekStartDate   DateTime
  weekEndDate     DateTime
  totalSearches   Int      @default(0)
  searchSummary   String   // JSON array of search summaries
  topicsExplored  String[] @default([])
  reportUrl       String?  // URL to download/view report
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Child Subjects - Tracks which subjects a student has registered for
model ChildSubject {
  id            String   @id @default(uuid())
  child         User     @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId       String
  subjectName   String   @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@unique([childId, subjectName])
}

// AI-Generated Assignments
model GeneratedAssignment {
  id                    String   @id @default(uuid())
  child                 User     @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId               String
  subject               String
  topic                 String
  title                 String
  instructions          String
  board                 String
  grade                 Int
  complexity            String   // Easy, Medium, Hard, Mixed
  
  questionsJson         String   // JSON array of questions with correct_answer
  submittedAnswersJson  String?  // JSON array of submitted answers (null if not submitted)
  feedbackJson          String?  // JSON object with AI feedback (null if not graded)
  
  score                 Float?   // Total marks awarded
  totalMarks            Int
  estimatedMinutes      Int
  submittedAt           DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// AI Credit Logging
model AiCreditLog {
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  userId           String   @map("user_id") @db.VarChar(36)
  userRole         String   @map("user_role") @db.VarChar(20)
  sessionId        String?  @map("session_id") @db.VarChar(36)
  feature          String   @db.VarChar(100)
  modelProvider    String   @default("GOOGLE") @map("model_provider") @db.VarChar(50)
  modelName        String   @default("gemini-2.5-flash") @map("model_name") @db.VarChar(100)
  promptTokens     Int      @default(0) @map("prompt_tokens") @db.Integer
  completionTokens Int      @default(0) @map("completion_tokens") @db.Integer
  totalTokens      Int      @default(0) @map("total_tokens") @db.Integer
  costUsd          Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?     @map("latency_ms") @db.Integer
  wasFallback      Boolean  @default(false) @map("was_fallback")
  fallbackReason   String?  @map("fallback_reason") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  
  @@index([userId], name: "idx_user")
  @@index([createdAt], name: "idx_date")
  @@index([feature], name: "idx_feature")
  @@map("ai_credit_logs")
}

model AiCreditDailySummary {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  summaryDate   DateTime @map("summary_date") @db.Date
  userId        String   @map("user_id") @db.VarChar(36)
  userRole      String   @map("user_role") @db.VarChar(20)
  feature       String   @db.VarChar(100)
  modelName     String   @map("model_name") @db.VarChar(100)
  callCount     Int      @default(0) @map("call_count") @db.Integer
  totalTokens   BigInt   @default(0) @map("total_tokens") @db.BigInt
  totalCostUsd  Decimal  @default(0) @map("total_cost_usd") @db.Decimal(12, 6)
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  @@unique([summaryDate, userId, feature, modelName], name: "uq_daily")
  @@index([summaryDate, userId], name: "idx_date_user")
  @@map("ai_credit_daily_summary")
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MOD
  SUPPORT
  FINANCE
}

model Admin {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  invitedBy    BigInt?   @map("invited_by") @db.BigInt
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  inviter      Admin?    @relation("AdminInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitees     Admin[]   @relation("AdminInviter")
  sentInvites  AdminInvite[]
  
  @@map("admins")
}

model AdminInvite {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  email     String   @db.VarChar(320)
  role      AdminRole
  tokenHash String   @map("token_hash") @db.VarChar(255)
  invitedBy BigInt   @map("invited_by") @db.BigInt
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  inviter   Admin    @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  
  @@index([tokenHash], name: "idx_token")
  @@index([email], name: "idx_email")
  @@map("admin_invites")
}

// ─── AI-Generated Practice Tests ─────────────────────────────────────────────
// PRACTICE ROUTE CONTRACT
// Prisma models: prisma.practiceTest    (@@map "practice_tests")
//                prisma.practiceAttempt (@@map "practice_attempts")
// NEVER use: prisma.generatedPracticeTest / prisma.generatedPracticeAttempt
// childId: UUID string from User.id (no conversion needed)
// practiceTestId: saved.id.toString() from DB — never temp_*

model PracticeTest {
  id            String   @id @default(uuid())
  childId       String   @map("child_id")
  subject       String
  topic         String
  complexity    String   // Easy, Medium, Hard, Mixed
  questionsJson String   @map("questions_json") // JSON array with correct_answer (server-only)
  totalMarks    Int      @map("total_marks")
  durationMins  Int      @default(15) @map("duration_mins")
  createdAt     DateTime @default(now()) @map("created_at")

  child    User             @relation(fields: [childId], references: [id], onDelete: Cascade)
  attempts PracticeAttempt[]

  @@index([childId], name: "idx_pt_child")
  @@index([childId, subject], name: "idx_pt_child_subject")
  @@map("practice_tests")
}

model PracticeAttempt {
  id              String    @id @default(uuid())
  practiceTestId  String    @map("practice_test_id")
  childId         String    @map("child_id")
  answersJson     String    @map("answers_json")  // [{questionId, answer}]
  feedbackJson    String?   @map("feedback_json") // Full AI feedback JSON
  score           Float?                          // Percentage 0-100
  marksAwarded    Int?      @map("marks_awarded")
  marksPossible   Int?      @map("marks_possible")
  timeTakenSecs   Int?      @map("time_taken_secs")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  test  PracticeTest @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  child User         @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, practiceTestId], name: "idx_pa_child_test")
  @@index([childId, createdAt], name: "idx_pa_child_date")
  @@map("practice_attempts")
}

// ─── Teacher Role ─────────────────────────────────────────────────────────────
// TEACHER SCHEMA CONTRACT
// - Teacher is a separate entity from User/Admin
// - childId in enrollment/submission tables = User.id (UUID string, role=STUDENT)
// - All teacher IDs are BigInt; all childId/userId are String UUIDs
// - NEVER mix Teacher sessions with Admin or Student sessions

model Teacher {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(320)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  schoolName    String    @map("school_name") @db.VarChar(255)
  mobile        String?   @db.VarChar(512)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  classes     TeacherClass[]
  assignments TeacherAssignment[]

  @@map("teachers")
}

model TeacherClass {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  teacherId    BigInt   @map("teacher_id") @db.BigInt
  className    String   @map("class_name") @db.VarChar(100)
  grade        String   @db.VarChar(5)
  board        String   @db.VarChar(20)
  academicYear String   @default("2024-25") @map("academic_year") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  teacher     Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjects    TeacherClassSubject[]
  enrollments ClassEnrollment[]
  assignments TeacherAssignment[]
  inviteTokens ClassInviteToken[]

  @@index([teacherId], name: "idx_tc_teacher")
  @@map("teacher_classes")
}

model TeacherClassSubject {
  id          BigInt @id @default(autoincrement()) @db.BigInt
  teacherId   BigInt @map("teacher_id") @db.BigInt
  classId     BigInt @map("class_id") @db.BigInt
  subjectName String @map("subject_name") @db.VarChar(100)

  class TeacherClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectName], name: "uq_tcs")
  @@map("teacher_class_subjects")
}

model ClassEnrollment {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  classId    BigInt   @map("class_id") @db.BigInt
  childId    String   @map("child_id") @db.VarChar(36)
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  class TeacherClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  child User         @relation("StudentEnrollments", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([classId, childId], name: "uq_enrollment")
  @@index([classId], name: "idx_ce_class")
  @@index([childId], name: "idx_ce_child")
  @@map("class_enrollments")
}

model TeacherAssignment {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  teacherId     BigInt   @map("teacher_id") @db.BigInt
  classId       BigInt   @map("class_id") @db.BigInt
  subject       String   @db.VarChar(100)
  topic         String   @db.VarChar(255)
  complexity    String   @db.VarChar(20)
  instructions  String?  @db.Text
  questionsJson Json     @map("questions_json")
  totalMarks    Int      @map("total_marks") @db.Integer
  dueDate       DateTime @map("due_date")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  teacher     Teacher                       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       TeacherClass                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions TeacherAssignmentSubmission[]
  reminders   AssignmentReminder[]

  @@index([teacherId], name: "idx_ta_teacher")
  @@index([classId], name: "idx_ta_class")
  @@index([dueDate], name: "idx_ta_due")
  @@map("teacher_assignments")
}

model TeacherAssignmentSubmission {
  id                  BigInt    @id @default(autoincrement()) @db.BigInt
  teacherAssignmentId BigInt    @map("teacher_assignment_id") @db.BigInt
  childId             String    @map("child_id") @db.VarChar(36)
  answersJson         Json?     @map("answers_json")
  aiFeedbackJson      Json?     @map("ai_feedback_json")
  teacherFeedbackJson Json?     @map("teacher_feedback_json")
  teacherReviewedAt   DateTime? @map("teacher_reviewed_at")
  teacherReleasedAt   DateTime? @map("teacher_released_at")
  score               Decimal?  @db.Decimal(5, 2)
  status              String    @default("NOT_STARTED") @db.VarChar(20)
  submittedAt         DateTime? @map("submitted_at")
  reminderSentAt      DateTime? @map("reminder_sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  assignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  child      User              @relation("StudentSubmissions", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([teacherAssignmentId, childId], name: "uq_submission")
  @@index([teacherAssignmentId], name: "idx_sub_assignment")
  @@index([childId], name: "idx_sub_child")
  @@index([status], name: "idx_sub_status")
  @@map("teacher_assignment_submissions")
}

model AssignmentReminder {
  id                  BigInt   @id @default(autoincrement()) @db.BigInt
  teacherAssignmentId BigInt   @map("teacher_assignment_id") @db.BigInt
  childId             String   @map("child_id") @db.VarChar(36)
  parentEmail         String   @map("parent_email") @db.VarChar(320)
  sentAt              DateTime @default(now()) @map("sent_at")
  channel             String   @default("EMAIL") @db.VarChar(20)

  assignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)

  @@index([teacherAssignmentId, childId], name: "idx_reminder_assignment")
  @@map("assignment_reminders")
}

model ClassInviteToken {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  classId   BigInt   @map("class_id") @db.BigInt
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  class TeacherClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([tokenHash], name: "idx_cit_token")
  @@map("class_invite_tokens")
}

model TeacherQuestionBank {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  teacherId   BigInt   @map("teacher_id") @db.BigInt
  subject     String   @db.VarChar(100)
  grade       String   @db.VarChar(5)
  board       String   @db.VarChar(20)
  questionJson Json    @map("question_json")
  usedCount   Int      @default(0) @map("used_count") @db.Integer
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([teacherId, subject], name: "idx_qb_teacher_subject")
  @@map("teacher_question_bank")
}

model ParentCommunicationLog {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  teacherId     BigInt   @map("teacher_id") @db.BigInt
  childId       String   @map("child_id") @db.VarChar(36)
  parentEmail   String   @map("parent_email") @db.VarChar(320)
  messageType   String   @map("message_type") @db.VarChar(50)
  subject       String   @db.VarChar(255)
  sentAt        DateTime @default(now()) @map("sent_at")

  @@index([teacherId, childId], name: "idx_pcl_teacher_child")
  @@map("parent_communication_logs")
}

enum NotificationUserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum NotificationPriority {
  high
  medium
  low
}

enum NotificationCategory {
  assignment
  feedback
  reminder
  submission
  payment
  report
  system
  progress
}

model Notification {
  id        BigInt               @id @default(autoincrement()) @db.BigInt
  userId    String               @map("user_id") @db.VarChar(64)
  userRole  NotificationUserRole @map("user_role")
  title     String               @db.VarChar(255)
  body      String               @db.Text
  href      String?              @db.VarChar(500)
  priority  NotificationPriority @default(medium)
  category  NotificationCategory @default(system)
  isRead    Boolean              @default(false) @map("is_read")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId, userRole, isRead], name: "idx_notif_user")
  @@index([createdAt], name: "idx_notif_created")
  @@map("notifications")
}

model TeacherVerificationToken {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  teacherId  BigInt   @map("teacher_id") @db.BigInt
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tokenHash], name: "idx_tvt_token")
  @@map("teacher_verification_tokens")
}

 model StudentSession {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  childId      String    @map("child_id") @db.VarChar(36)
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  durationSecs Int?      @map("duration_secs")
  pageViews    Int       @default(0) @map("page_views")
  @@map("student_sessions")
}
